    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.60.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.20.0",
    "prisma": "^7.10.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
